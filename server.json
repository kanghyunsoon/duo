{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kanghyunsoon/duo",
  "title": "DUO",
  "description": "Reviews AI coding agent changes against human-confirmed engineering Decisions in a Git repo",
  "repository": {
    "url": "https://github.com/kanghyunsoon/duo",
    "source": "github"
  },
  "websiteUrl": "https://github.com/kanghyunsoon/duo#readme",
  "version": "0.4.0-rc.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@duo-director/cli",
      "version": "0.4.0-rc.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "--root-from"
        },
        {
          "type": "positional",
          "value": "git-cwd"
        }
      ]
    }
  ]
}
