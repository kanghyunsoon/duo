{
  "$comment": "ADR-010 의존 방향의 단일 원본. eslint.config.js와 scripts/check-boundaries.mjs가 읽는다.",
  "packages": {
    "@duo-director/core": {
      "dir": "packages/core",
      "allow": [],
      "typeOnly": []
    },
    "@duo-director/analyzer": {
      "dir": "packages/analyzer",
      "allow": [
        "@duo-director/core"
      ],
      "typeOnly": []
    },
    "@duo-director/graph": {
      "dir": "packages/graph",
      "allow": [
        "@duo-director/analyzer",
        "@duo-director/core"
      ],
      "typeOnly": []
    },
    "@duo-director/director": {
      "dir": "packages/director",
      "allow": [
        "@duo-director/graph",
        "@duo-director/analyzer",
        "@duo-director/core"
      ],
      "typeOnly": []
    },
    "@duo-director/integration": {
      "dir": "packages/integration",
      "allow": [
        "@duo-director/director",
        "@duo-director/graph",
        "@duo-director/analyzer",
        "@duo-director/core"
      ],
      "typeOnly": []
    },
    "@duo-director/ui": {
      "dir": "packages/ui",
      "allow": [],
      "typeOnly": [
        "@duo-director/core"
      ]
    },
    "@duo-director/cli": {
      "dir": "apps/cli",
      "allow": [
        "@duo-director/integration",
        "@duo-director/director",
        "@duo-director/graph",
        "@duo-director/analyzer",
        "@duo-director/core"
      ],
      "typeOnly": []
    }
  },
  "nodeSqliteAllowed": "packages/graph/src/store/node-sqlite",
  "treeSitter": {
    "$comment": "web-tree-sitter는 analyzer의 tree-sitter 계층에서만 import한다(T05). Tree-sitter 타입이 LanguageAnalyzer 계약 밖으로 새지 않게 한다.",
    "dir": "packages/analyzer/src/language/tree-sitter",
    "modules": [
      "web-tree-sitter"
    ]
  },
  "typescriptApi": {
    "$comment": "TypeScript Compiler API는 graph의 TypeScriptModuleResolver에서만 import한다(T07). TypeScript 7 API 변화가 이 adapter 밖으로 번지지 않게 한다.",
    "dir": "packages/graph/src/build/resolve/typescript",
    "modules": [
      "typescript"
    ]
  },
  "cliForbiddenNodeModules": [
    "node:fs",
    "node:fs/promises",
    "node:child_process",
    "node:sqlite",
    "node:http",
    "node:net"
  ],
  "tokenizer": {
    "$comment": "gpt-tokenizer(o200k_base, ADR-005)는 director의 tokens 계층에서만 import한다(T10). 공식 토큰 값의 출처를 한 곳으로 둔다.",
    "dir": "packages/director/src/tokens",
    "modules": [
      "gpt-tokenizer",
      "gpt-tokenizer/encoding/o200k_base"
    ]
  },
  "llmVendorSdk": {
    "$comment": "LLM vendor SDK는 integration의 llm adapter 계층에서만 import한다(T12A, ADR-012). director는 LLMProvider 계약만 소유하고 vendor 타입을 모른다.",
    "dir": "packages/integration/src/llm",
    "modules": [
      "openai",
      "@anthropic-ai/sdk",
      "@google/genai",
      "@google/generative-ai",
      "@mistralai/mistralai",
      "ollama",
      "cohere-ai",
      "groq-sdk",
      "ai"
    ]
  },
  "mcpSdk": {
    "$comment": "MCP TypeScript SDK는 integration의 mcp adapter 계층에서만 import한다(TASK-016). 공유 operation과 core/graph/director에는 MCP 타입이 없다.",
    "dir": "packages/integration/src/mcp",
    "modules": [
      "@modelcontextprotocol/server",
      "@modelcontextprotocol/client",
      "@modelcontextprotocol/core",
      "@modelcontextprotocol/sdk"
    ]
  },
  "sourceParsing": {
    "$comment": "YAML/Markdown 라이브러리는 core의 source 계층에서만 import한다(T02). 라이브러리 타입이 domain 밖으로 새지 않게 한다.",
    "dir": "packages/core/src/source",
    "modules": [
      "yaml",
      "mdast",
      "mdast-util-from-markdown",
      "mdast-util-frontmatter",
      "micromark-extension-frontmatter"
    ]
  }
}
