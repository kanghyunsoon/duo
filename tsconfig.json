{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "customConditions": [
      "@duo-director/source"
    ],
    "allowJs": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "packages/ui/**"
  ]
}
