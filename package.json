{
  "name": "duo-director-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:grammars": "vitest run packages/analyzer/src/language/tree-sitter/grammars.test.ts",
    "pack:cli": "node scripts/pack-cli.mjs",
    "test:dist": "node scripts/pack-cli.mjs && vitest run --config vitest.dist.config.ts --reporter=verbose",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "docs:validate": "tsc -b packages/core && node scripts/validate-docs.mjs",
    "verify": "pnpm check:boundaries && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm docs:validate",
    "duoctl": "node apps/cli/dist/main.js"
  },
  "devDependencies": {
    "@duo-director/core": "workspace:*",
    "@duo-director/graph": "workspace:*",
    "@duo-director/integration": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "^24.19.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
