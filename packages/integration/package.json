{
  "name": "@duo-director/integration",
  "version": "0.0.0",
  "private": true,
  "description": "MCP, Codex/Claude adapters, local HTTP API",
  "type": "module",
  "exports": {
    ".": {
      "@duo-director/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agents": {
      "@duo-director/source": "./src/agents/index.ts",
      "types": "./dist/agents/index.d.ts",
      "default": "./dist/agents/index.js"
    },
    "./http": {
      "@duo-director/source": "./src/http/index.ts",
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./llm": {
      "@duo-director/source": "./src/llm/index.ts",
      "types": "./dist/llm/index.d.ts",
      "default": "./dist/llm/index.js"
    },
    "./mcp": {
      "@duo-director/source": "./src/mcp/index.ts",
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./operations": {
      "@duo-director/source": "./src/operations/index.ts",
      "types": "./dist/operations/index.d.ts",
      "default": "./dist/operations/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@duo-director/analyzer": "workspace:*",
    "@duo-director/core": "workspace:*",
    "@duo-director/director": "workspace:*",
    "@duo-director/graph": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "openai": "7.23.0",
    "smol-toml": "1.9.0",
    "zod": "4.6.7"
  }
}
